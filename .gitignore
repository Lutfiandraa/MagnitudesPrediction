# ============================================================
# MagnitudeAI — .gitignore
# Covers: Next.js (frontend) + Python/FastAPI (backend)
# ============================================================

# ─── OS / System ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ─── Editor / IDE ───────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace
.idea/
*.suo
*.user
*.swp
*.swo
*~

# ============================================================
# FRONTEND — Next.js / Node.js
# ============================================================

# Dependencies
frontend/node_modules/
node_modules/

# Next.js build output
frontend/.next/
frontend/out/

# Production build
frontend/build/
frontend/dist/

# Environment variables
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
.env
.env.local
.env*.local

# Next.js cache
frontend/.next/cache/

# TypeScript
*.tsbuildinfo
frontend/next-env.d.ts

# Vercel
.vercel

# Turbo
.turbo

# PWA
frontend/public/sw.js
frontend/public/workbox-*.js

# ============================================================
# BACKEND — Python / FastAPI
# ============================================================

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual environments
backend/venv/
backend/.venv/
backend/env/
backend/.env/
venv/
.venv/

# Distribution / packaging
backend/dist/
backend/build/
backend/*.egg-info/
*.egg

# Testing
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage
backend/coverage.xml
*.cover

# ML model artifacts — exclude umum, tapi WHITELIST file yang dipakai project ini
# (le_target.pkl, le_remark.pkl, dan xgb_magnitude_model.json WAJIB ikut di-push
#  karena backend butuh file ini untuk bisa berjalan sama sekali)
backend/*.pkl
backend/*.joblib
backend/*.h5
backend/*.pt
backend/*.pth
backend/*.onnx

!backend/le_target.pkl
!backend/le_remark.pkl
!backend/xgb_magnitude_model.json

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/
*.ipynb

# MyPy / type checkers
backend/.mypy_cache/
.mypy_cache/
.dmypy.json

# Logs
*.log
logs/
backend/logs/

# ─── Misc ───────────────────────────────────────────────────
*.bak
*.tmp
*.temp